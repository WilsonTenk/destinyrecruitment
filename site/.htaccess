# Edinam Destiny Recruitment – Apache settings for cPanel hosting.
# GitHub Pages ignores this file; it only takes effect on the cPanel server.

# ---------- Basics ----------
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8
AddType image/webp .webp
AddType image/svg+xml .svg

# Keep internal files private
<FilesMatch "^(README\.md|\.cpanel\.yml|\.git.*)$|\.(sqlite|sqlite-wal|sqlite-shm|json\.bak)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 /\.git

# ---------- Force HTTPS ----------
# Turn on AutoSSL in cPanel first, then this sends every visitor to https://
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Blog pages come from the admin database but keep their .html addresses
  RewriteRule ^blog\.html$ blog.php [L,QSA]
  RewriteRule ^(blog-[a-z0-9-]+)\.html$ article.php?slug=$1 [L,QSA]

  # Private folders (each also has its own "deny" file)
  RewriteRule ^(inc|data)(/|$) - [R=404,L]

  # Optional: pick one address for the site. Uncomment ONE block.
  # (a) Send www.example.com to example.com
  # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  # RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
  # (b) Send example.com to www.example.com
  # RewriteCond %{HTTP_HOST} !^www\. [NC]
  # RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ---------- Security headers ----------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # Same rules as the pages' own meta tag, plus frame-ancestors (only works as a header)
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; frame-src https://www.google.com https://maps.google.com; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
  # HSTS: tells browsers to always use HTTPS. Uncomment ONLY after HTTPS works
  # on the domain (and www, if used), because browsers remember it for a year.
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header unset X-Powered-By
</IfModule>
ServerSignature Off

# ---------- Caching ----------
# CSS/JS/images are cache-busted with ?v=N in the pages, so they can be cached long.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/plain "access plus 1 hour"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# ---------- Compression ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript text/javascript image/svg+xml application/ld+json
</IfModule>
